{
  "name": "wager-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:integration": "bun test --timeout 60000 test/integration",
    "migration:up": "bun src/scripts/migrate.ts up",
    "migration:down": "bun src/scripts/migrate.ts down",
    "migration:status": "bun src/scripts/migrate.ts status",
    "infra:up": "docker compose up -d postgres localstack",
    "infra:down": "docker compose down -v"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/nestjs": "^6.1.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/express": "^5.0.0",
    "typescript": "^5.6.3"
  }
}
